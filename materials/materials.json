{
  "_meta": {
    "version": "1.2.2",
    "description": "rsf-friction 内置材质参数表（与 rsf.js 中 RSF.materials 保持一致）",
    "pairing": "每条记录均为一对接触材质（material1 × material2），摩擦系数属于接触面而非单一材质；自配对（如钢-钢）表示同种材料相互接触；岩石数据为同种岩石对磨实验值。",
    "unit": {
      "mu": "无量纲（库仑动摩擦系数）",
      "muS": "无量纲（库仑静摩擦系数）",
      "mu0": "无量纲（参考摩擦系数）",
      "a": "无量纲（直接效应系数）",
      "b": "无量纲（演化效应系数）",
      "Dc": "m（临界滑移距离，1e-6 m = 1 μm）",
      "V0": "m/s（参考速度）"
    },
    "category": {
      "rock": "岩石类（含 RSF 参数，computeFriction 自动走 RSF 模式）",
      "metal": "金属类（仅库仑 μ/μ_s，走库仑模式）",
      "polymer": "聚合物类（塑料/橡胶，仅库仑 μ/μ_s）",
      "other": "其他非金属（玻璃/木材/混凝土/冰等，仅库仑 μ/μ_s）"
    },
    "disclaimer": "库仑 μ/μ_s 为常见工程材料干摩擦的教科书/工程手册量级参考值；RSF 参数（mu0/a/b/Dc/V0）为岩石摩擦实验的典型量级。不同批次材料差异很大，实际仿真建议用实测/标定值替换。",
    "sources": [
      "Serway & Jewett《Physics for Scientists and Engineers》摩擦系数表",
      "Engineering ToolBox 摩擦系数参考表",
      "机械设计手册 / 工程摩擦系数表",
      "Dieterich, J. H. (1979), JGR 84(B5)",
      "Ruina, A. (1983), JGR 88(B12)",
      "Marone, C. (1998), Annu. Rev. Earth Planet. Sci. 26"
    ]
  },
