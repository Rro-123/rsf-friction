{
  "name": "rsf-friction",
  "version": "1.3.0",
  "description": "速率-状态摩擦定律（Rate-and-State Friction, RSF）计算库 — 三变量（材质/压力/速度）计算摩擦力",
  "main": "rsf.js",
  "types": "index.d.ts",
  "unpkg": "rsf.js",
  "jsdelivr": "rsf.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./rsf.js",
      "default": "./rsf.js"
    },
    "./materials/*.json": "./materials/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "rsf.js",
    "index.d.ts",
    "demo/",
    "docs/",
    "materials/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node --test",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "friction",
    "rate-and-state",
    "stick-slip",
    "tribology",
    "physics",
    "rsf",
    "earthquake"
  ],
  "author": "Rro-123",
  "license": "MIT",
  "homepage": "https://rro-123.github.io/rsf-friction/",
  "bugs": {
    "url": "https://github.com/Rro-123/rsf-friction/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rro-123/rsf-friction.git"
  }
}
